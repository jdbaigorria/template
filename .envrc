# AWS
export AWS_PROFILE=""
export AWS_REGION=""
export AWS_ACCOUNT=""
export AWS_STAGE="dev"

# Proyecto
export CUSTOMER=""
export SERVICE=""
export SERVICE_NAME="${CUSTOMER}-${SERVICE}"

# Registry provider
export REGISTRY_PROVIDER="${REGISTRY_PROVIDER:-ecr}"
export DOCKERFILE_PATH="${DOCKERFILE_PATH:-docker/Dockerfile.aws}"

# Tag por defecto
if [ -z "${IMAGE_TAG:-}" ]; then
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git rev-parse HEAD >/dev/null 2>&1; then
    export IMAGE_TAG="$(git rev-parse --short HEAD)"
  else
    export IMAGE_TAG="$(date +%Y%m%d%H%M%S)"
  fi
fi

# Derivación de imagen según registry
if [[ "$REGISTRY_PROVIDER" == "ecr" ]]; then
  export ECR_REGISTRY="${AWS_ACCOUNT}.dkr.ecr.${AWS_REGION}.amazonaws.com"
  export IMAGE_REPOSITORY="${CUSTOMER}/${SERVICE}"
  export IMAGE_NAME="${ECR_REGISTRY}/${IMAGE_REPOSITORY}:${IMAGE_TAG}"

elif [[ "$REGISTRY_PROVIDER" == "dockerhub" ]]; then
  export DOCKERHUB_NAMESPACE=""
  export IMAGE_REPOSITORY="${DOCKERHUB_NAMESPACE}/${SERVICE}"
  export IMAGE_NAME="${IMAGE_REPOSITORY}:${IMAGE_TAG}"

else
  echo "Unsupported REGISTRY_PROVIDER: $REGISTRY_PROVIDER" >&2
  return 1
fi

# Python venv local
if [[ -d "$PWD/.venv/bin" ]]; then
  export PATH="$PWD/.venv/bin:$PATH"
  export VIRTUAL_ENV="$PWD/.venv"
fi

# Scripts en PATH
export PATH="$PWD/scripts:$PATH"
